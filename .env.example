# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Qwen model-serving (course endpoint; base URL should include /v1) ---
# UI is NOT hosted on TACC; only the backend calls this API.
QWEN_BASE_URL=https://api.kilo.ai/api/gateway/chat/completions
QWEN_MODEL=kilo-auto/free
WEB_SEARCH_MODE=duckduckgo
# --- Baseline toggle ---
# 1 = Proposed (Agents 1-4, include Travel_History)
# 0 = Baseline A (Agents 1-3 only)
ENABLE_TRAVEL_HISTORY=1

# --- Tools (stub during early dev; switch to overpass for real OSM data) ---
# TOOL_STAYS_MODE: stub (default, offline-safe) | overpass (OpenStreetMap, no auth) | api (not wired yet)
TOOL_STAYS_MODE=stub
TOOL_MAPS_MODE=stub

# --- OpenStreetMap Overpass API (Agent 1, used when TOOL_STAYS_MODE=overpass) ---
# Free, no authentication required. Queries OSM for hotels/motels/hostels near
# the destination. Returns real names, coordinates, and addresses.
# Multiple mirrors can be comma-separated for resilience.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT=30
OVERPASS_RADIUS_METERS=5000

# --- Stay search provider (Agent 1, used when TOOL_STAYS_MODE=api) ---
# OBO Travel MCP API (https://onebookingonline.com/mcp) — free, no auth required
# for keyless access (30 req/min, 500 req/day). Returns live prices, booking URLs,
# and cancellation info. Set STAYS_API_KEY for higher limits.
STAYS_API_BASE_URL=https://onebookingonline.com/mcp
STAYS_API_KEY=
STAYS_API_TIMEOUT=30

# --- Travel History store ---
# Default: local SQLite (no extra services).
DATABASE_URL=sqlite:///./data/travel_history.sqlite
# Optional Postgres (Agent 4 only; chat conversations still use SQLite):
# 1) docker compose up -d postgres
# 2) pip install '.[db]'   # or: pip install 'psycopg[binary]'
# 3) uncomment one of:
# DATABASE_URL=postgresql://trip:trip@localhost:5432/travel_history
# DATABASE_URL=postgresql+psycopg://trip:trip@localhost:5432/travel_history

# --- Langfuse (optional observability) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=0

# --- Optional default origin for forms only (NOT a hard product requirement) ---
# DEFAULT_ORIGIN=

# --- NVIDIA Nemotron API (Agent 6, used when EVENTS_MODE=ticketmaster) ---
# Get a free API key from https://build.nvidia.com/
# Rate limits: 5 requests/second, 10000 requests/day (free tier).
NEMOTRON_API_KEY=
NEMOTRON_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
